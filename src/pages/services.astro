---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import BookingButton from "@/components/BookingButton.astro";
import LinkHomePage from "@/components/LinkHomePage.astro";

let services = await getCollection("services");
const primaryServices = services
  .filter((service) => {
    return service.data.category == "primary";
  })
  .sort((a, b) => a.data.order - b.data.order);
const secondaryServices = services
  .filter((service) => {
    return service.data.category == "secondary";
  })
  .sort((a, b) => a.data.order - b.data.order);
const addOnServices = services
  .filter((service) => {
    return service.data.category == "addOn";
  })
  .sort((a, b) => a.data.order - b.data.order);

import ServiceListing from "@/components/ServiceListing.astro";
import redReliefFacialImg from "@/assets/services/red-relief-facial.jpg";

const pageTitle = "Service List";
---

<BaseLayout pageTitle={pageTitle}>
  <section class="mx-auto">
    <div class="relative h-[480px] w-full">
      <Image
        src={redReliefFacialImg}
        alt="facials"
        class="h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 h-full w-full bg-black opacity-60"></div>
    </div>
  </section>
  <section
    class="flex flex-col items-center gap-6 mx-auto max-w-prose mt-16 mb-16 px-8"
  >
    <p>
      Please view our services and book an appointment at the link below. You
      will be directed to our online scheduling page to view hours and
      availability.
    </p>
    <BookingButton />
  </section>
</BaseLayout>
