---
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"services">[];
}

const { items } = Astro.props;
---

{
  items.map(async (item) => {
    const { Content } = await item.render();
    if (item.data.category == "primary") {
      return (
        <article class="flex flex-col gap-2">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-1 w-full p-2">
            <h3 class="text-2xl text-left">
              {item.data.duration} minute {item.data.title}
            </h3>
            <p class="text-2xl">${item.data.cost}</p>
          </div>
          <div class="prose px-2">
            <Content />
          </div>
        </article>
      );
    } else if (item.data.category == "secondary") {
      return (
        <article class="flex flex-col gap-2">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-1 w-full p-2">
            <h3 class="text-2xl text-left">
              {item.data.title}, {item.data.duration} minutes
            </h3>
            <p class="text-2xl">${item.data.cost}</p>
          </div>
          <div class="prose px-2">
            <Content />
          </div>
        </article>
      );
    } else {
      return (
        <article class="flex flex-col gap-2">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-1 w-full p-2">
            <h3 class="text-2xl text-left">
              {item.data.title}, {item.data.duration} mins
            </h3>
            <p class="text-2xl">
              ${item.data.cost}
              {item.data.altCost && <span>/${item.data.altCost}</span>}
            </p>
          </div>
          <div class="prose px-2">
            <Content />
          </div>
        </article>
      );
    }
  })
}
